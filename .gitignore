# 本地系统文件
.DS_Store

# 临时与备份
.backup/
.superpowers/
.config/

# 本地密钥与配置
app/.env
app/data/model-config/

# 便携运行时：Neo4j 二进制与数据（通过 scripts/install-neo4j.sh 安装）
neo4j/*
!neo4j/README.md
!neo4j/conf-template/
!neo4j/conf-template/neo4j.conf

# Python 环境与缓存
app/backend/.venv/
app/backend/.venv-simulation/
__pycache__/
*.pyc
.pytest_cache/

# Node 环境与构建产物
node_modules/
app/frontend/dist/

# 运行时数据
app/backend/uploads/
app/backend/logs/
app/backend/data/

# 本地向量模型权重与自动生成的说明（保留占位文件）
app/models/embeddings/**
!app/models/embeddings/.gitkeep
**/mirofish-model.json
app/backend/data/world/
app/backend/data/world-sim/
